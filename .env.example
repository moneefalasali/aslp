# ============================================
# ملف إعدادات البيئة - Smart Learning System
# نسخة المثال (قم بنسخ هذا الملف إلى .env وملء القيم)
# ============================================

# ============================================
# OpenAI API Configuration
# ============================================
# احصل على المفتاح من: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# نموذج GPT المستخدم للتحليل
OPENAI_MODEL=gpt-4o

# ============================================
# Wasabi S3 Storage Configuration
# ============================================
# احصل على بيانات الاعتماد من: https://wasabisys.com/
WASABI_ACCESS_KEY=your-wasabi-access-key-here
WASABI_SECRET_KEY=your-wasabi-secret-key-here
WASABI_BUCKET_NAME=your-bucket-name-here
WASABI_REGION=us-east-1
WASABI_ENDPOINT_URL=https://s3.wasabisys.com

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=sqlite:///./smart_learning.db
# PostgreSQL example for Render hosting:
# DATABASE_URL=postgresql://username:password@hostname:5432/database_name

# ============================================
# Server Configuration
# ============================================
DEBUG=False
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000

# ============================================
# Authentication Configuration
# ============================================
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Admin Configuration
# ============================================
ADMIN_EMAIL=admin@smartlearning.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# File Upload Configuration
# ============================================
MAX_FILE_SIZE=52428800

# ============================================
# Application Settings
# ============================================
APP_NAME=Smart Learning System
APP_VERSION=1.0.0
